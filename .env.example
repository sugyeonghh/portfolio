# 이 파일을 .env.local 로 복사해서 사용하세요.

# true(기본값): src/data/mockProjects.ts 의 샘플 데이터를 사용
# false: 아래 API 주소로 실제 요청
VITE_USE_MOCK=true

# 프론트엔드가 요청할 API 기본 경로 (기본값: /api)
#  - 같은 도메인에서 서비스하거나 개발 프록시를 쓸 때: /api
#  - 다른 도메인의 백엔드를 직접 호출할 때: https://api.example.com (백엔드에 CORS 설정 필요)
VITE_API_BASE_URL=/api

# 개발 서버 전용: /api 요청을 넘겨줄 백엔드 주소 (Spring Boot 기본 포트 8080)
VITE_API_PROXY_TARGET=http://localhost:8080
